<ui:FluentWindow x:Class="Yatta.App.TrayPanelWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Wpf;assembly=Microsoft.AspNetCore.Components.WebView.Wpf"
    xmlns:razor="clr-namespace:Yatta.App.Blazor"
    Title="Yatta" Width="350" Height="440" ResizeMode="NoResize" WindowStyle="None" ShowInTaskbar="False"
    WindowCornerPreference="Round" Deactivated="Window_Deactivated" Loaded="Window_Loaded">
    <blazor:BlazorWebView HostPage="wwwroot\index.html" Services="{DynamicResource services}">
        <blazor:BlazorWebView.RootComponents>
            <blazor:RootComponent Selector="#app" ComponentType="{x:Type razor:TrayPanel}" />
        </blazor:BlazorWebView.RootComponents>
    </blazor:BlazorWebView>
</ui:FluentWindow>
