<ui:FluentWindow x:Class="Yatta.App.Views.Dialogs.ReminderCustomDialogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:local="clr-namespace:Yatta.App.Markup"
    xmlns:controls="clr-namespace:Yatta.App.Controls"
    SizeToContent="Height"
    Width="500"
    MinWidth="500"
    MaxWidth="500"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Topmost="True"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    Loaded="Window_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="24,0,24,0">
            <TextBlock x:Name="DialogTitleText"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8" />
            <TextBlock x:Name="DialogDescriptionText"
                       FontSize="13"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Margin="0,0,0,28" />

            <TextBlock Text="{local:Localize Dialog_ReminderWhenQuestion}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Margin="0,0,0,12" />

            <StackPanel x:Name="ReminderOptionsPanel">
                <Border x:Name="UntilTimeOptionBorder"
                        Padding="12"
                        CornerRadius="8"
                        BorderThickness="1"
                        Margin="0,0,0,10"
                        MouseLeftButtonDown="OnUntilTimeOptionClick">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <RadioButton x:Name="UntilTimeRadioButton"
                                         GroupName="ReminderOptions"
                                         IsChecked="True"
                                         VerticalAlignment="Center"
                                         Margin="0,0,12,0" />
                            <ui:SymbolIcon Grid.Column="1"
                                           Symbol="Timer24"
                                           FontSize="16"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="0,0,12,0" />
                            <TextBlock Grid.Column="2"
                                       Text="{local:Localize Dialog_ReminderUntilLabel}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <StackPanel x:Name="TimeInputPanel"
                                    Orientation="Horizontal"
                                    Margin="44,0,0,12">
                            <ui:NumberBox x:Name="NextHoursNumberBox"
                                          Width="96"
                                          Height="38"
                                          Margin="0,0,8,0"
                                          Minimum="0"
                                          Maximum="24" />
                            <TextBlock Text="{local:Localize Label_Hours}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,14,0" />
                            <ui:NumberBox x:Name="NextMinutesNumberBox"
                                          Width="96"
                                          Height="38"
                                          Margin="0,0,8,0"
                                          Minimum="0"
                                          Maximum="59" />
                            <TextBlock Text="{local:Localize Label_Minutes}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel x:Name="AdjustButtonsPanel"
                                    Orientation="Horizontal"
                                    Margin="44,0,0,0">
                            <ui:Button Content="{local:Localize Button_Minus1h}"
                                       Click="OnMinus1hClick"
                                       Height="30"
                                       MinWidth="64"
                                       Margin="0,0,8,0" />
                            <ui:Button Content="{local:Localize Button_Minus15m}"
                                       Click="OnMinus15mClick"
                                       Height="30"
                                       MinWidth="64"
                                       Margin="0,0,8,0" />
                            <ui:Button Content="{local:Localize Button_Plus15m}"
                                       Click="OnPlus15mClick"
                                       Height="30"
                                       MinWidth="64"
                                       Margin="0,0,8,0" />
                            <ui:Button Content="{local:Localize Button_Plus1h}"
                                       Click="OnPlus1hClick"
                                       Height="30"
                                       MinWidth="64" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="SpecificTimeOptionBorder"
                        Padding="12"
                        CornerRadius="8"
                        BorderThickness="1"
                        Margin="0,0,0,10"
                        MouseLeftButtonDown="OnSpecificTimeOptionClick">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <RadioButton x:Name="UntilSpecificTimeRadioButton"
                                         GroupName="ReminderOptions"
                                         VerticalAlignment="Center"
                                         Margin="0,0,12,0" />
                            <ui:SymbolIcon Grid.Column="1"
                                           Symbol="Clock24"
                                           FontSize="16"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="0,0,12,0" />
                            <TextBlock Grid.Column="2"
                                       Text="{local:Localize Dialog_ReminderUntilSpecificTime}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <StackPanel x:Name="SpecificTimePanel"
                                    Orientation="Horizontal"
                                    Margin="44,12,0,0">
                            <TextBlock Text="{local:Localize Label_At}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <controls:TimePickerControl x:Name="SpecificTimePicker"
                                                        Width="140"
                                                        Height="40" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="UntilTomorrowOptionBorder"
                        Padding="12"
                        CornerRadius="8"
                        BorderThickness="1"
                        Margin="0,0,0,18"
                        MouseLeftButtonDown="OnUntilTomorrowOptionClick">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <RadioButton x:Name="UntilTomorrowRadioButton"
                                     GroupName="ReminderOptions"
                                     VerticalAlignment="Top"
                                     Margin="0,1,12,0" />
                        <ui:SymbolIcon Grid.Column="1"
                                       Symbol="Calendar24"
                                       FontSize="16"
                                       VerticalAlignment="Top"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="0,2,12,0" />
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{local:Localize Dialog_ReminderUntilTomorrow}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{local:Localize Dialog_ReminderTomorrowDescription}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <Separator Margin="0,0,0,16" />

            <TextBlock Text="{local:Localize Dialog_ReminderDefaultInterval}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Margin="0,0,0,6" />
            <TextBlock Text="{local:Localize Dialog_ReminderDefaultIntervalDescription}"
                       FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8" />

            <ComboBox x:Name="DefaultIntervalComboBox"
                      Height="42"
                      HorizontalAlignment="Stretch"
                      SelectionChanged="OnDefaultIntervalSelectionChanged"
                      Margin="0,0,0,12">
                <ComboBoxItem Tag="Minutes15" Content="{local:Localize Notification_15min}" />
                <ComboBoxItem Tag="Minutes10" Content="{local:Localize Notification_10min}" />
                <ComboBoxItem Tag="Minutes30" Content="{local:Localize Notification_30min}" />
                <ComboBoxItem Tag="Hour1" Content="{local:Localize Notification_1hour}" />
                <ComboBoxItem Tag="Hours2" Content="{local:Localize Notification_2hours}" />
                <ComboBoxItem Tag="Custom" Content="{local:Localize Notification_Customize}" />
            </ComboBox>

            <StackPanel x:Name="DefaultCustomIntervalPanel"
                        Orientation="Horizontal"
                        Margin="0,0,0,16">
                <ui:NumberBox x:Name="DefaultHoursNumberBox"
                              Width="96"
                              Height="38"
                              Margin="0,0,8,0"
                              Minimum="0"
                              Maximum="24" />
                <TextBlock Text="{local:Localize Label_Hours}"
                           VerticalAlignment="Center"
                           Margin="0,0,14,0" />
                <ui:NumberBox x:Name="DefaultMinutesNumberBox"
                              Width="96"
                              Height="38"
                              Margin="0,0,8,0"
                              Minimum="0"
                              Maximum="59" />
                <TextBlock Text="{local:Localize Label_Minutes}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <Separator Margin="0,0,0,16" />

            <TextBlock Text="{local:Localize Dialog_ReminderNotificationState}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Margin="0,0,0,12" />

            <ui:ToggleSwitch x:Name="NotificationsEnabledToggle"
                             Checked="OnNotificationsEnabledChanged"
                             Unchecked="OnNotificationsEnabledChanged"
                             Margin="4,0,0,12">
                <ui:ToggleSwitch.Content>
                    <StackPanel>
                        <TextBlock Text="{local:Localize Label_EnableNotifications}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{local:Localize Description_Notifications}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </ui:ToggleSwitch.Content>
            </ui:ToggleSwitch>

            <ui:ToggleSwitch x:Name="KeepNotificationsVisibleToggle"
                             Margin="4,0,0,0">
                <ui:ToggleSwitch.Content>
                    <StackPanel>
                        <TextBlock Text="{local:Localize Label_KeepNotificationsVisible}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{local:Localize Description_KeepNotificationsVisible}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </ui:ToggleSwitch.Content>
            </ui:ToggleSwitch>

            <TextBlock x:Name="ErrorText"
                       FontSize="12"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                       Margin="0,12,0,0"
                       TextWrapping="Wrap"
                       Visibility="Collapsed" />
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="24,28,24,24">
            <ui:Button x:Name="CancelButton"
                       Click="OnCancelClick"
                       MinWidth="100"
                       Height="38"
                       Margin="0,0,12,0" />
            <ui:Button x:Name="PrimaryButton"
                       Appearance="Primary"
                       Click="OnPrimaryClick"
                       MinWidth="96"
                       Height="38" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
