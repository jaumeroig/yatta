@namespace Yatta.App.Blazor
@implements IDisposable
@inject IServiceScopeFactory Scopes
@inject ILocalizationService L
@inject IThemeService ThemeService
@inject TimeEntryService Entries
@inject UiEventService Events

<div class="quick-panel @UiFormat.ThemeClass(ThemeService)" lang="@L.GetCurrentCulture()">
    <span class="eyebrow">Yatta</span><h1>@L.GetString(Active is null ? "Dialog_StartActivity_Title" : "Dialog_ChangeActivity_Title")</h1>
    <p class="muted">@(Active is null ? L.GetString("Tray_NoActivity") : ActivityName(Active.ActivityId))</p>
    <div class="field"><label for="quick-activity">@L.GetString("Label_Activity")</label><select id="quick-activity" @bind="ActivityId"><option value="00000000-0000-0000-0000-000000000000">@L.GetString("Placeholder_SelectActivity")</option>@foreach (Activity item in Activities.Where(a => a.Active).OrderBy(a => a.Name)) { <option value="@item.Id">@item.Name</option> }</select></div>
    <div class="field"><label><input type="checkbox" @bind="Telework" /> @L.GetString("Location_Telework")</label></div>
    <div class="field"><label for="quick-notes">@L.GetString("Label_Notes")</label><textarea id="quick-notes" @bind="Notes"></textarea></div>
    @if (!string.IsNullOrEmpty(Error)) { <BbAlert Variant="AlertVariant.Danger"><BbAlertDescription>@Error</BbAlertDescription></BbAlert> }
    <div class="action-row"><BbButton OnClick="SaveAsync" Disabled="Busy"><LucideIcon Name="@(Active is null ? "play" : "arrow-right-left")" Size="16" aria-hidden="true" focusable="false" />@(Active is null ? L.GetString("Button_Start") : L.GetString("Button_Change"))</BbButton></div>
    <BbPortalHost />
</div>

@code {
    private bool Busy;
    private List<Activity> Activities = [];
    private TimeRecord? Active;
    private Guid ActivityId;
    private bool Telework;
    private string Notes = string.Empty;
    private string Error = string.Empty;
    protected override async Task OnInitializedAsync()
    {
        L.CultureChanged += OnChanged;
        Events.DataChanged += OnDataChanged;
        Wpf.Ui.Appearance.ApplicationThemeManager.Changed += OnThemeChanged;
        await LoadAsync(true);
    }
    private async Task LoadAsync(bool initialize = false)
    {
        using IServiceScope scope = Scopes.CreateScope();
        Activities = (await scope.ServiceProvider.GetRequiredService<IActivityRepository>().GetAllAsync()).ToList();
        Active = await scope.ServiceProvider.GetRequiredService<ITimeRecordRepository>().GetActiveAsync();
        if (initialize)
        {
            ActivityId = Active?.ActivityId ?? Guid.Empty;
            Telework = Active?.Telework ?? false;
        }
        else if (!Activities.Any(activity => activity.Id == ActivityId && activity.Active))
        {
            ActivityId = Guid.Empty;
        }
    }
    private string ActivityName(Guid id) => Activities.FirstOrDefault(a => a.Id == id)?.Name ?? L.GetString("Activity_Unknown");
    private void OnDataChanged(object? sender, EventArgs args) => _ = InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); });
    private void OnChanged(object? sender, EventArgs args) => _ = InvokeAsync(StateHasChanged);
    private void OnThemeChanged(Wpf.Ui.Appearance.ApplicationTheme theme, System.Windows.Media.Color accent) => _ = InvokeAsync(StateHasChanged);
    private async Task SaveAsync()
    {
        if (Busy) { return; }
        Busy = true;
        Error = string.Empty;
        try { await SaveCoreAsync(); }
        catch { Error = L.GetString("UI_OperationFailed"); }
        finally { Busy = false; }
    }

    private async Task SaveCoreAsync()
    {
        try { await Entries.StartOrSwitchAsync(ActivityId, Telework, Notes); Events.CompleteQuickAction(); }
        catch (ArgumentException) { Error = L.GetString("Validation_ActivityRequired"); }
    }
    public void Dispose() { L.CultureChanged -= OnChanged; Events.DataChanged -= OnDataChanged; Wpf.Ui.Appearance.ApplicationThemeManager.Changed -= OnThemeChanged; }
}
